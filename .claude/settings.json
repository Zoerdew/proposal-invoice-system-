{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash(npm run build)",
      "Bash(npm run dev)",
      "Bash(npm install:*)",
      "Bash(npx tsc:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Read(.env*)",
      "Bash(git push --force:*)",
      "Bash(vercel deploy:*)",
      "Bash(vercel --prod:*)"
    ]
  }
}
